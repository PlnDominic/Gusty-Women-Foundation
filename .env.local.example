# ── Paystack ─────────────────────────────────────────────
# Get keys from https://dashboard.paystack.com/#/settings/developers
# Use test keys (pk_test_ / sk_test_) for development.
# Switch to live keys (pk_live_ / sk_live_) before going to production.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Email (contact form + Rooted & Radiant ticket bookings) ──
# Ticket bookings email the payment screenshot to the NGO and the ticket code to the buyer,
# so these must be set in production. For Gmail, use an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=gutsywomenfoundation@gmail.com
SMTP_PASS=your-app-password
